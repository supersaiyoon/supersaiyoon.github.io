<!DOCTYPE html>
<html lang="en">

<%- include("partials/head.ejs") %>

<body>
    <%- include("partials/header.ejs") %>

    <%- include("partials/nav.ejs") %>

    <main class="container">
        <h2><%= game.name %></h2>

        <img class="game-image" src="<%= game.background_image_additional %>" alt="Game background image">

        <p><span class="label">Description: </span><%= game.description_raw %></p>

        <p><span class="label">Release Year: </span><%= game.released %></p>

        <p><span class="label">Metascore: </span><%= game.metacritic %></p>

        <p><span class="label">Link to Website: </span><a href="<%= game.website %>" target="_blank">Click Here</a></p>

        <h3>Recent Reviews from Around the World</h3>
        <% reviews.forEach(r => { %>
            <p><span class="username"><%= r.username %>: </span>"<%= r.review %>"</p>
        <% }) %>
    </main>

    <%- include("partials/footer.ejs") %>
</body>

</html>